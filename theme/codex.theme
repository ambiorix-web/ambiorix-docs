{
  "metadata": {
    "name": "Codex",
    "revision": 1,
    "license": "SPDX-License-Identifier: MIT",
    "copyright": ["Ambiorix docs — neutral dark, sage and terracotta from the project logo"]
  },
  "background-color": "#1c1c1c",
  "text-color": "#e9e9e9",
  "line-number-color": "#575757",
  "line-number-background-color": "#1c1c1c",
  "editor-colors": {
    "BackgroundColor": "#1c1c1c",
    "CurrentLine": "#262626",
    "LineNumbers": "#575757",
    "Separator": "#2b2b2b",
    "TextSelection": "#33422a",
    "BracketMatching": "#2b2b2b",
    "IndentationLine": "#262626",
    "MarkError": "#d96a52",
    "MarkWarning": "#d6c08f",
    "SearchHighlight": "#33422a",
    "WordWrapMarker": "#262626"
  },
  "text-styles": {
    "Normal":          { "text-color": "#e9e9e9", "selected-text-color": "#e9e9e9" },
    "Operator":        { "text-color": "#b8b8b8", "selected-text-color": "#b8b8b8" },

    "Comment":         { "text-color": "#8a8a8a", "selected-text-color": "#8a8a8a", "italic": true },
    "CommentVar":      { "text-color": "#8a8a8a", "selected-text-color": "#8a8a8a", "italic": true },
    "Documentation":   { "text-color": "#9a9a9a", "selected-text-color": "#9a9a9a", "italic": true },
    "Annotation":      { "text-color": "#8a8a8a", "selected-text-color": "#8a8a8a", "italic": true },
    "Information":     { "text-color": "#8a8a8a", "selected-text-color": "#8a8a8a" },
    "RegionMarker":    { "text-color": "#8a8a8a", "selected-text-color": "#8a8a8a" },

    "String":          { "text-color": "#a3c489", "selected-text-color": "#a3c489" },
    "SpecialString":   { "text-color": "#a3c489", "selected-text-color": "#a3c489" },
    "VerbatimString":  { "text-color": "#a3c489", "selected-text-color": "#a3c489" },
    "Char":            { "text-color": "#a3c489", "selected-text-color": "#a3c489" },
    "SpecialChar":     { "text-color": "#bcd8a5", "selected-text-color": "#bcd8a5" },
    "Import":          { "text-color": "#a3c489", "selected-text-color": "#a3c489" },

    "Function":        { "text-color": "#d9834f", "selected-text-color": "#d9834f" },
    "BuiltIn":         { "text-color": "#d9834f", "selected-text-color": "#d9834f" },
    "Others":          { "text-color": "#d9834f", "selected-text-color": "#d9834f" },
    "Extension":       { "text-color": "#d9834f", "selected-text-color": "#d9834f" },

    "Keyword":         { "text-color": "#c0a8cf", "selected-text-color": "#c0a8cf" },
    "ControlFlow":     { "text-color": "#c0a8cf", "selected-text-color": "#c0a8cf" },
    "Preprocessor":    { "text-color": "#c0a8cf", "selected-text-color": "#c0a8cf" },
    "DataType":        { "text-color": "#c0a8cf", "selected-text-color": "#c0a8cf" },

    "DecVal":          { "text-color": "#d6c08f", "selected-text-color": "#d6c08f" },
    "BaseN":           { "text-color": "#d6c08f", "selected-text-color": "#d6c08f" },
    "Float":           { "text-color": "#d6c08f", "selected-text-color": "#d6c08f" },
    "Constant":        { "text-color": "#d6c08f", "selected-text-color": "#d6c08f" },
    "Attribute":       { "text-color": "#d6c08f", "selected-text-color": "#d6c08f" },
    "Variable":        { "text-color": "#e9e9e9", "selected-text-color": "#e9e9e9" },

    "Alert":           { "text-color": "#d9834f", "selected-text-color": "#d9834f", "bold": true },
    "Warning":         { "text-color": "#d6c08f", "selected-text-color": "#d6c08f" },
    "Error":           { "text-color": "#d96a52", "selected-text-color": "#d96a52", "underline": true }
  }
}
